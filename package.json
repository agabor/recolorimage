{
	"name": "recolorimages",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"pre-render": "node server.js",
		"build:plugin": "rm -rf dist plugin-build && vite build && npm run pre-render && mkdir -p plugin-build/recolorimage && cp -r dist recolorimage.php wordpress-plugin-readme.md plugin-build/recolorimage/ && node update-version.js && cd plugin-build && zip -r recolorimage.zip recolorimage && rm -rf recolorimage",
		"preview": "vite preview",
		"test:unit": "vitest",
		"lint": "eslint . --fix",
		"format": "prettier --write src/"
	},
	"dependencies": {
		"chroma-js": "^3.1.2",
		"terser": "^5.39.0",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@eslint/js": "^9.20.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"marked": "^15.0.8",
		"@vitest/eslint-plugin": "1.1.31",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/test-utils": "^2.4.6",
		"canvas": "^3.1.0",
		"eslint": "^9.20.1",
		"eslint-plugin-vue": "^9.32.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.5.1",
		"vite": "^6.2.5",
		"vite-plugin-vue-devtools": "^7.7.2",
		"vitest": "^3.0.5"
	}
}
